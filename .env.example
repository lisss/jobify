# Backend — SQLite by default (zero Docker). Swap to Postgres when ready:
# DATABASE_URL=postgresql+psycopg://jobify:jobify@localhost:5432/jobify
DATABASE_URL=sqlite:///./jobify.db
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_ENABLED=true

# Optional — improve live learning lookups (Open Library / GitHub / SO work without these)
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GITHUB_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8001
